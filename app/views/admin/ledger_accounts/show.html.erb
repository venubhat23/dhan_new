<% a = @account %>
<div class="container-fluid py-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <%= link_to admin_ledger_accounts_path, class: 'text-decoration-none small' do %><i class="bi bi-arrow-left"></i> Chart of Accounts<% end %>
      <h3 class="mb-0 mt-1"><%= a.name %> <span class="badge bg-primary-subtle text-primary fs-6 align-middle"><%= a.type_label %></span></h3>
      <% if a.description.present? %><small class="text-muted"><%= a.description %></small><% end %>
    </div>
    <div class="text-end">
      <div class="small text-muted">Closing Balance (published)</div>
      <h3 class="mb-0">₹<%= number_with_delimiter(number_with_precision(@balance, precision: 2)) %></h3>
      <%= link_to new_admin_manual_journal_path, class: 'btn btn-sm btn-primary mt-2' do %><i class="bi bi-plus-lg me-1"></i>New Journal<% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Date</th><th>Journal#</th><th>Status</th><th>Description</th><th>Contact</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
        <tbody>
          <% if @lines.empty? %><tr><td colspan="7" class="text-center text-muted py-5">No transactions on this account yet.</td></tr><% end %>
          <% @lines.each do |l| %>
            <% jn = l.manual_journal %>
            <tr class="<%= 'text-muted' unless jn.published? %>">
              <td><%= jn.journal_date.strftime('%d/%m/%Y') %></td>
              <td><%= link_to "##{jn.journal_number}", admin_manual_journal_path(jn), class: 'text-decoration-none fw-semibold' %></td>
              <td><span class="badge <%= jn.published? ? 'bg-success' : 'bg-secondary' %>"><%= jn.status.upcase %></span></td>
              <td class="small"><%= l.description.presence || jn.notes %></td>
              <td class="small"><%= l.contact_name %></td>
              <td class="text-end"><%= l.debit.to_f.positive? ? "₹#{number_with_precision(l.debit, precision: 2, delimiter: ',')}" : '' %></td>
              <td class="text-end"><%= l.credit.to_f.positive? ? "₹#{number_with_precision(l.credit, precision: 2, delimiter: ',')}" : '' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
