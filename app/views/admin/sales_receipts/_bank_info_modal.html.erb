<%# Update Bank Info modal. Open with openBankInfoModal(button); the button carries
    data-url plus the current values (data-bank-*). %>
<div class="modal fade" id="bankInfoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="bankInfoForm" method="post" data-turbo="false">
      <input type="hidden" name="_method" value="patch">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-bank me-1 text-primary"></i>Update Bank Info <small class="text-muted" id="biReceipt"></small></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" for="biBankDate">Bank Date</label>
            <input type="date" class="form-control" id="biBankDate" name="sales_receipt[bank_date]">
          </div>
          <div class="col-md-6"></div>
          <div class="col-12">
            <label class="form-label" for="biNarration">Bank Narration</label>
            <textarea class="form-control" id="biNarration" name="sales_receipt[bank_narration]" rows="2" placeholder="e.g. UPI/CR/432198765/Customer name"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="biOpening">Opening Balance (₹)</label>
            <input type="number" step="0.01" class="form-control" id="biOpening" name="sales_receipt[bank_opening_balance]">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="biClosing">Closing Balance (₹)</label>
            <input type="number" step="0.01" class="form-control" id="biClosing" name="sales_receipt[bank_closing_balance]">
          </div>
        </div>
        <div class="form-text mt-2"><i class="bi bi-check-circle-fill text-success"></i> A tick shows in the list once all 4 fields are filled.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Bank Info</button>
      </div>
    </form>
  </div>
</div>
<script>
  (function() {
    const modalEl = document.getElementById('bankInfoModal');
    if (modalEl && modalEl.parentElement !== document.body) document.body.appendChild(modalEl);

    window.openBankInfoModal = function(el) {
      const d = el.dataset;
      document.getElementById('bankInfoForm').action = d.url;
      document.getElementById('biReceipt').textContent = d.receipt || '';
      document.getElementById('biBankDate').value = d.bankDate || '';
      document.getElementById('biNarration').value = d.bankNarration || '';
      document.getElementById('biOpening').value = d.bankOpening || '';
      document.getElementById('biClosing').value = d.bankClosing || '';
      bootstrap.Modal.getOrCreateInstance(document.getElementById('bankInfoModal')).show();
    };
  })();
</script>
