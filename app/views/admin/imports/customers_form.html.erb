<% content_for :page_title, "Import Customers" %>
<% content_for :page_subtitle, "Bulk Customer Import" %>

<div class="container-fluid">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-1">
        <i class="fas fa-users me-2"></i>
        Import Customers
      </h2>
      <p class="text-muted mb-0">Bulk upload customer data from CSV or Excel files</p>
    </div>
    <div>
      <%= link_to admin_imports_path, class: "btn btn-outline-secondary" do %>
        <i class="fas fa-arrow-left me-1"></i>
        Back to Imports
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Upload Form -->
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-cloud-upload-alt me-2"></i>
            Upload Customer Data
          </h5>
        </div>
        <div class="card-body p-4">
          <%= form_with url: admin_import_customers_path, multipart: true, local: true, class: "needs-validation", novalidate: true do |f| %>
            <div class="mb-4">
              <label for="file" class="form-label fw-bold">
                <i class="fas fa-file-csv me-2"></i>
                Select File
                <span class="text-danger">*</span>
              </label>
              <%= f.file_field :file,
                  class: "form-control form-control-lg",
                  accept: ".csv,.xlsx,.xls",
                  required: true,
                  id: "file" %>
              <div class="form-text">
                <i class="fas fa-info-circle me-1"></i>
                Supported formats: CSV, Excel (.xlsx, .xls). Maximum size: 10MB
              </div>
              <div class="invalid-feedback">
                Please select a valid file to upload.
              </div>
            </div>

            <!-- File Preview Section -->
            <div id="file-preview" class="mb-4" style="display: none;">
              <div class="alert alert-info">
                <div class="d-flex align-items-center">
                  <i class="fas fa-file-check me-2"></i>
                  <div>
                    <strong>File Selected:</strong> <span id="file-name"></span><br>
                    <small>Size: <span id="file-size"></span> | Type: <span id="file-type"></span></small>
                  </div>
                </div>
              </div>
            </div>

            <%= hidden_field_tag :column_mapping, '', id: 'column_mapping_input' %>

            <!-- Column Mapping Section (CSV only) -->
            <div id="column-mapping-section" class="mb-4" style="display: none;">
              <div class="card border-primary border-opacity-25">
                <div class="card-header bg-primary bg-opacity-10">
                  <h6 class="mb-0">
                    <i class="fas fa-random me-2"></i>
                    Map Your Columns
                  </h6>
                  <small class="text-muted">Your file's own headers don't have to match our template &mdash; tell us which column is which.</small>
                </div>
                <div class="card-body">
                  <div id="mapping-row-count" class="alert alert-success small mb-3" style="display: none;">
                    <i class="fas fa-users me-1"></i>
                    <span id="mapping-row-count-text"></span>
                  </div>
                  <div id="mapping-warning" class="alert alert-warning small mb-3" style="display: none;">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    <span id="mapping-warning-text"></span>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Your Column</th>
                          <th>Sample Values</th>
                          <th>Maps To</th>
                        </tr>
                      </thead>
                      <tbody id="mapping-table-body"></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <div id="excel-mapping-note" class="alert alert-secondary small mb-4" style="display: none;">
              <i class="fas fa-info-circle me-1"></i>
              Column mapping is only available for CSV files. This Excel file must use the exact template headers below.
            </div>

            <!-- Import Options -->
            <div class="card bg-light border-0 mb-4">
              <div class="card-body">
                <h6 class="card-title mb-3">
                  <i class="fas fa-cogs me-2"></i>
                  Import Options
                </h6>

                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="true" id="skip_header" name="skip_header" checked>
                      <label class="form-check-label" for="skip_header">
                        Skip header row
                      </label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="true" id="update_existing" name="update_existing">
                      <label class="form-check-label" for="update_existing">
                        Update existing customers (match by email)
                      </label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="true" id="create_user_accounts" name="create_user_accounts" checked>
                      <label class="form-check-label" for="create_user_accounts">
                        Create user accounts automatically
                      </label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" value="true" id="send_welcome_emails" name="send_welcome_emails">
                      <label class="form-check-label" for="send_welcome_emails">
                        Send welcome emails to customers
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <button type="submit" class="btn btn-primary btn-lg" id="submit-btn">
                <i class="fas fa-upload me-2"></i>
                Import Customers
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Download Template Card -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0">
            <i class="fas fa-download me-2"></i>
            Download Template
          </h5>
        </div>
        <div class="card-body">
          <p class="card-text mb-3">
            Download the standardized CSV template with all available customer fields to ensure proper data formatting.
          </p>

          <div class="d-grid gap-2">
            <%= link_to download_template_admin_imports_path(template_type: 'customers', format: 'csv'),
                class: "btn btn-success",
                target: "_blank" do %>
              <i class="fas fa-file-csv me-2"></i>
              Download CSV Template
            <% end %>

            <%= link_to download_template_admin_imports_path(template_type: 'customers', format: 'xlsx'),
                class: "btn btn-outline-success",
                target: "_blank" do %>
              <i class="fas fa-file-excel me-2"></i>
              Download Excel Template
            <% end %>
          </div>
        </div>
      </div>

      <!-- Import Guidelines -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="fas fa-info-circle me-2"></i>
            Import Guidelines
          </h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <h6 class="text-primary mb-2">Required Fields:</h6>
            <ul class="list-unstyled small">
              <li><i class="fas fa-check text-success me-1"></i> customer_name</li>
              <li><i class="fas fa-check text-success me-1"></i> mobile (must be unique)</li>
            </ul>
          </div>

          <div class="mb-3">
            <h6 class="text-primary mb-2">Optional Fields:</h6>
            <ul class="list-unstyled small">
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> email</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> whatsapp_number</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> gst_no</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> address (billing)</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> landmark</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> shipping_address</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> location_link</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> latitude</li>
              <li><i class="fas fa-circle text-muted me-1" style="font-size: 0.4rem;"></i> longitude</li>
            </ul>
          </div>

          <div class="alert alert-info small mb-2">
            <i class="fas fa-key me-1"></i>
            <strong>Default Password:</strong> Every imported customer is given the login password
            <code>dhanvantari@123</code> (shown on the customer's page, where it can be reset).
          </div>

          <div class="alert alert-warning small mb-0">
            <i class="fas fa-exclamation-triangle me-1"></i>
            <strong>Note:</strong> Duplicate mobile numbers will be skipped during import.
          </div>
        </div>
      </div>

      <!-- Data Validation -->
      <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="fas fa-shield-alt me-2"></i>
            Data Validation
          </h5>
        </div>
        <div class="card-body">
          <ul class="list-unstyled small mb-0">
            <li class="mb-2">
              <i class="fas fa-check-circle text-success me-2"></i>
              Email format validation (if provided)
            </li>
            <li class="mb-2">
              <i class="fas fa-check-circle text-success me-2"></i>
              Mobile number format validation
            </li>
            <li class="mb-2">
              <i class="fas fa-check-circle text-success me-2"></i>
              GST number stored in uppercase
            </li>
            <li class="mb-0">
              <i class="fas fa-check-circle text-success me-2"></i>
              Duplicate mobile / email detection
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Custom file input styling */
.form-control[type="file"] {
  border: 2px dashed #dee2e6;
  background-color: #f8f9fa;
  padding: 1rem;
  transition: all 0.3s ease;
}

.form-control[type="file"]:hover {
  border-color: #0d6efd;
  background-color: #e3f2fd;
}

.form-control[type="file"]:focus {
  border-color: #0d6efd;
  background-color: #fff;
  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

/* Card animations */
.card {
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
}

/* Form validation styles */
.was-validated .form-control:valid {
  border-color: #198754;
}

.was-validated .form-control:invalid {
  border-color: #dc3545;
}

/* Loading state for submit button */
.btn.loading {
  pointer-events: none;
  opacity: 0.7;
}

.btn.loading::after {
  content: "";
  display: inline-block;
  width: 1rem;
  height: 1rem;
  margin-left: 0.5rem;
  border: 2px solid transparent;
  border-top-color: currentColor;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Progress bar styling */
.progress-container {
  margin-top: 1rem;
  display: none;
}

.progress {
  height: 0.5rem;
  border-radius: 0.25rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const fileInput = document.getElementById('file');
  const filePreview = document.getElementById('file-preview');
  const fileName = document.getElementById('file-name');
  const fileSize = document.getElementById('file-size');
  const fileType = document.getElementById('file-type');
  const form = document.querySelector('form');
  const submitBtn = document.getElementById('submit-btn');

  // ---- Custom column mapping (CSV only) ----
  const mappingSection = document.getElementById('column-mapping-section');
  const mappingTableBody = document.getElementById('mapping-table-body');
  const excelNote = document.getElementById('excel-mapping-note');
  const columnMappingInput = document.getElementById('column_mapping_input');
  const mappingWarning = document.getElementById('mapping-warning');
  const mappingWarningText = document.getElementById('mapping-warning-text');
  const mappingRowCount = document.getElementById('mapping-row-count');
  const mappingRowCountText = document.getElementById('mapping-row-count-text');

  const MAPPING_FIELDS = [
    { value: '', label: '-- Ignore this column --' },
    { value: 'full_name', label: 'Full Name' },
    { value: 'mobile', label: 'Mobile' },
    { value: 'email', label: 'Email' },
    { value: 'whatsapp_number', label: 'WhatsApp Number' },
    { value: 'gst_no', label: 'GST Number' },
    { value: 'address', label: 'Billing Address' },
    { value: 'landmark', label: 'Landmark' },
    { value: 'shipping_address', label: 'Shipping Address' },
    { value: 'location_link', label: 'Location Link' },
    { value: 'latitude', label: 'Latitude' },
    { value: 'longitude', label: 'Longitude' },
    { value: 'status', label: 'Status (active/inactive)' }
  ];

  function guessField(header) {
    const h = header.toLowerCase();
    if (h.includes('whatsapp')) return 'whatsapp_number';
    if (h.includes('mobile') || h.includes('phone') || h.includes('contact')) return 'mobile';
    if (h.includes('email') || h.includes('mail')) return 'email';
    if (h.includes('gst')) return 'gst_no';
    if (h.includes('shipping')) return 'shipping_address';
    if (h.includes('landmark')) return 'landmark';
    if (h.includes('address')) return 'address';
    if (h.includes('location') || h.includes('map') || h.includes('link')) return 'location_link';
    if (h.includes('latitude') || h === 'lat') return 'latitude';
    if (h.includes('longitude') || h === 'lng' || h === 'long') return 'longitude';
    if (h.includes('status') || h.includes('active')) return 'status';
    if (h.includes('name')) return 'full_name';
    return '';
  }

  // Minimal RFC4180-ish CSV line parser (handles quoted fields with commas/escaped quotes)
  function parseCSVLine(line) {
    const result = [];
    let cur = '';
    let inQuotes = false;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (inQuotes) {
        if (ch === '"') {
          if (line[i + 1] === '"') { cur += '"'; i++; } else { inQuotes = false; }
        } else {
          cur += ch;
        }
      } else if (ch === '"') {
        inQuotes = true;
      } else if (ch === ',') {
        result.push(cur); cur = '';
      } else {
        cur += ch;
      }
    }
    result.push(cur);
    return result.map(function(s) { return s.trim(); });
  }

  function renderMappingTable(headers, dataRows) {
    mappingTableBody.innerHTML = '';
    const usedTargets = {};
    const sampleRow = dataRows[0] || [];

    // Show how many customer rows were found in the uploaded file.
    const total = dataRows.length;
    mappingRowCountText.textContent =
      total + (total === 1 ? ' customer row' : ' customer rows') + ' found in this file — all of them will be imported.';
    mappingRowCount.style.display = total > 0 ? 'block' : 'none';

    headers.forEach(function(header, idx) {
      const guessed = guessField(header);
      const target = (guessed && !usedTargets[guessed]) ? guessed : '';
      if (target) usedTargets[target] = true;

      const tr = document.createElement('tr');

      const headerTd = document.createElement('td');
      const code = document.createElement('code');
      code.textContent = header;
      headerTd.appendChild(code);
      tr.appendChild(headerTd);

      const sampleTd = document.createElement('td');
      sampleTd.className = 'text-muted small';
      const samples = dataRows.slice(0, 3)
        .map(function(r) { return (r[idx] || '').toString().trim(); })
        .filter(function(v) { return v.length > 0; });
      sampleTd.textContent = samples.length ? samples.join(', ') : (sampleRow[idx] || '');
      if (dataRows.length > 3 && samples.length) sampleTd.textContent += ', …';
      tr.appendChild(sampleTd);

      const selectTd = document.createElement('td');
      const select = document.createElement('select');
      select.className = 'form-select form-select-sm mapping-select';
      select.dataset.header = header;
      MAPPING_FIELDS.forEach(function(f) {
        const opt = document.createElement('option');
        opt.value = f.value;
        opt.textContent = f.label;
        if (f.value === target) opt.selected = true;
        select.appendChild(opt);
      });
      selectTd.appendChild(select);
      tr.appendChild(selectTd);

      mappingTableBody.appendChild(tr);
    });

    mappingSection.style.display = 'block';
    excelNote.style.display = 'none';
    mappingWarning.style.display = 'none';
  }

  function buildMapping() {
    const mapping = {};
    document.querySelectorAll('.mapping-select').forEach(function(select) {
      if (select.value) mapping[select.dataset.header] = select.value;
    });
    return mapping;
  }

  // Handle file selection
  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];

    if (file) {
      // Show file preview
      filePreview.style.display = 'block';
      fileName.textContent = file.name;
      fileSize.textContent = formatFileSize(file.size);
      fileType.textContent = file.type || 'Unknown';

      // Add visual feedback
      fileInput.classList.add('is-valid');
      fileInput.classList.remove('is-invalid');

      if (/\.csv$/i.test(file.name)) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          const text = String(evt.target.result || '');
          const lines = text.split(/\r\n|\n|\r/).filter(function(l) { return l.trim().length > 0; });
          if (lines.length > 0) {
            const headers = parseCSVLine(lines[0]);
            const dataRows = lines.slice(1).map(parseCSVLine);
            renderMappingTable(headers, dataRows);
          }
        };
        reader.readAsText(file);
      } else {
        mappingSection.style.display = 'none';
        excelNote.style.display = 'block';
        mappingRowCount.style.display = 'none';
        columnMappingInput.value = '';
      }
    } else {
      filePreview.style.display = 'none';
      fileInput.classList.remove('is-valid');
      mappingSection.style.display = 'none';
      excelNote.style.display = 'none';
      mappingRowCount.style.display = 'none';
    }
  });

  // Form submission handling
  form.addEventListener('submit', function(e) {
    if (mappingSection.style.display !== 'none') {
      const mapping = buildMapping();
      const mappedTargets = Object.values(mapping);
      const missing = [];
      if (mappedTargets.indexOf('full_name') === -1) missing.push('Full Name');
      if (mappedTargets.indexOf('mobile') === -1) missing.push('Mobile');

      if (missing.length > 0) {
        e.preventDefault();
        e.stopImmediatePropagation();
        mappingWarningText.textContent = 'Please map a column to: ' + missing.join(', ') + '.';
        mappingWarning.style.display = 'block';
        mappingWarning.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      columnMappingInput.value = JSON.stringify(mapping);
    }

    // Add loading state
    submitBtn.classList.add('loading');
    submitBtn.disabled = true;

    // Show progress (you can enhance this with actual progress tracking)
    const progressContainer = document.createElement('div');
    progressContainer.className = 'progress-container';
    progressContainer.innerHTML = `
      <div class="progress">
        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
             role="progressbar" style="width: 100%">
          Uploading and processing...
        </div>
      </div>
    `;

    submitBtn.parentElement.appendChild(progressContainer);
    progressContainer.style.display = 'block';
  });

  // File size formatter
  function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';

    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));

    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  // Form validation
  form.addEventListener('submit', function(e) {
    if (!form.checkValidity()) {
      e.preventDefault();
      e.stopPropagation();
    }

    form.classList.add('was-validated');
  });

  // Drag and drop functionality
  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
    fileInput.addEventListener(eventName, preventDefaults, false);
  });

  function preventDefaults(e) {
    e.preventDefault();
    e.stopPropagation();
  }

  ['dragenter', 'dragover'].forEach(eventName => {
    fileInput.addEventListener(eventName, highlight, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    fileInput.addEventListener(eventName, unhighlight, false);
  });

  function highlight(e) {
    fileInput.style.borderColor = '#0d6efd';
    fileInput.style.backgroundColor = '#e3f2fd';
  }

  function unhighlight(e) {
    fileInput.style.borderColor = '#dee2e6';
    fileInput.style.backgroundColor = '#f8f9fa';
  }

  fileInput.addEventListener('drop', handleDrop, false);

  function handleDrop(e) {
    const dt = e.dataTransfer;
    const files = dt.files;

    if (files.length > 0) {
      fileInput.files = files;
      fileInput.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }
});
</script>