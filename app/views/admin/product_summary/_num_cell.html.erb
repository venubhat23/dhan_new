<%
  danger    = local_assigns[:danger]
  editable  = local_assigns.fetch(:editable, false)
  step      = local_assigns[:step] || 1
  has_value = !value.nil?
  num       = has_value ? (value.to_f == value.to_i ? value.to_i : value.to_f.round(2)) : nil
%>
<td class="text-center <%= 'table-danger' if danger %>">
  <% if editable %>
    <span class="pse-cell">
      <input type="number" step="<%= step %>" min="0" readonly
             name="<%= name %>" value="<%= num %>"
             data-original="<%= num %>"
             class="pse-input form-control form-control-sm text-center"
             aria-label="<%= name %>">
      <button type="button" class="pse-edit-cell" title="Edit this value" tabindex="-1">
        <i class="bi bi-pencil"></i>
      </button>
    </span>
  <% else %>
    <span class="pse-val"><%= has_value ? num : '—' %></span>
  <% end %>
</td>
