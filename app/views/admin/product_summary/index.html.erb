<% content_for :title, "Product Summary" %>

<style>
  #pse-table th, #pse-table td { white-space: nowrap; }
  #pse-table thead th { position: sticky; top: 0; z-index: 2; }

  /* Read-only by default: inputs look like plain text until you click the pencil */
  .pse-cell { display: inline-flex; align-items: center; gap: 2px; }
  .pse-input {
    width: 58px;
    padding: 1px 4px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    cursor: default;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .pse-input::-webkit-outer-spin-button,
  .pse-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pse-input:read-only { pointer-events: none; }
  .pse-input.pse-editing {
    border-color: #86b7fe;
    background: #fff;
    box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
    cursor: text;
  }
  .pse-input.pse-dirty {
    border-color: #ffc107;
    background: #fff3cd;
  }
  .pse-edit-cell {
    visibility: hidden;
    border: 0;
    background: none;
    color: #6c757d;
    line-height: 1;
    padding: 0;
    font-size: .78rem;
  }
  #pse-table td:hover .pse-edit-cell { visibility: visible; }
  .pse-input.pse-editing + .pse-edit-cell,
  .pse-input.pse-dirty + .pse-edit-cell { visibility: visible; color: #0d6efd; }

  /* Saving overlay */
  #pse-overlay {
    position: fixed; inset: 0; z-index: 2000;
    display: none; align-items: center; justify-content: center;
    background: rgba(15, 23, 42, .45); backdrop-filter: blur(3px);
  }
  #pse-overlay.pse-show { display: flex; }
  .pse-overlay-card {
    background: #fff; border-radius: 16px; padding: 30px 34px;
    width: min(380px, 90vw); text-align: center;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .35);
  }
  .pse-overlay-card .pse-pct {
    font-size: 2.6rem; font-weight: 700; color: #198754; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .pse-overlay-card .pse-label { color: #6c757d; font-size: .9rem; margin-top: 6px; }
  .pse-track {
    height: 9px; background: #e9ecef; border-radius: 999px;
    overflow: hidden; margin: 16px 0 4px;
  }
  .pse-fill {
    height: 100%; width: 0;
    background: linear-gradient(90deg, #20c997, #198754);
    border-radius: 999px; transition: width .35s ease;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h2 class="mb-1">
      <i class="bi bi-table text-primary me-2"></i>Product Summary
    </h2>
    <p class="text-muted mb-0">Main store &amp; per-store stock and low-stock thresholds for every product and variant</p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-primary" id="pse-bulk-btn">
      <i class="bi bi-pencil-square me-1"></i>Bulk Edit
    </button>
    <%= link_to admin_products_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-box-seam me-1"></i>All Products
    <% end %>
  </div>
</div>

<div class="row g-2 mb-3">
  <div class="col-12 col-md-6 col-lg-4">
    <select id="pse-search" class="form-select" data-placeholder="Search a product…">
      <option value=""></option>
      <% @products.each do |product| %>
        <option value="<%= product.id %>"><%= product.name %><%= " — #{product.sku}" if product.sku.present? %></option>
      <% end %>
    </select>
  </div>
  <div class="col-auto">
    <button type="button" class="btn btn-outline-secondary" id="pse-search-clear">
      <i class="bi bi-x-circle me-1"></i>Show all
    </button>
  </div>
</div>

<div class="alert alert-info py-2 px-3 small pse-edit-hint">
  <i class="bi bi-info-circle me-1"></i>
  The table is read-only. Click the <i class="bi bi-pencil"></i> pencil on a cell to edit that one value, or hit
  <strong>Bulk Edit</strong> to open every cell at once, then <strong>Save Changes</strong>.
  Increasing a <strong>Main Store</strong> stock value adds a new stock batch for the difference;
  decreasing it draws the difference down from existing batches (FIFO). Store values are set directly.
  For a product <strong>with variants</strong>, editing the parent row's Main Store stock applies the
  change to its default variant, and editing a parent store value writes the product-level store row
  (the parent figure shown is a roll-up, so it may not echo the exact number you typed).
</div>

<%= form_with url: admin_product_summary_path, method: :patch, local: true, html: { id: "pse-form", class: "pse-form" } do %>
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-end align-items-center gap-2 pse-actions d-none">
      <span class="small text-muted me-auto"><span class="pse-dirty-count">0</span> unsaved change(s)</span>
      <button type="button" class="btn btn-outline-secondary btn-sm" id="pse-cancel-btn">Cancel</button>
      <button type="submit" class="btn btn-success btn-sm">
        <i class="bi bi-check-lg me-1"></i>Save Changes
      </button>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height: 78vh;">
        <table class="table table-hover table-bordered align-middle mb-0" id="pse-table" style="font-size: 0.83rem;">
          <thead class="table-light">
            <tr>
              <th rowspan="2" class="ps-3">Product / Variant</th>
              <th rowspan="2">SKU</th>
              <th rowspan="2">Category</th>
              <th colspan="2" class="text-center bg-primary-subtle">Main Store</th>
              <% @stores.each do |store| %>
                <th colspan="2" class="text-center bg-success-subtle"><%= store.name %></th>
              <% end %>
            </tr>
            <tr>
              <th class="text-center bg-primary-subtle">Stock</th>
              <th class="text-center bg-primary-subtle">Low Threshold</th>
              <% @stores.each do |_store| %>
                <th class="text-center bg-success-subtle">Stock</th>
                <th class="text-center bg-success-subtle">Low Threshold</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @products.each do |product| %>
              <%
                variants   = product.sorted_variants
                main_stock = @main_stock[product.id].to_f
                main_thr   = product.low_stock_threshold
              %>
              <tr data-pse-row="<%= product.id %>">
                <td class="ps-3 fw-semibold"><%= product.name %></td>
                <td><%= product.sku %></td>
                <td><%= product.category&.name %></td>

                <%= render "num_cell",
                      value: main_stock,
                      name: "main_products[#{product.id}][stock]",
                      editable: true,
                      danger: (main_thr && main_stock <= main_thr.to_f) %>
                <%= render "num_cell",
                      value: main_thr,
                      name: "main_products[#{product.id}][threshold]",
                      editable: true %>

                <% @stores.each do |store| %>
                  <% s_qty = @store_prod_qty[[store.id, product.id]] %>
                  <% s_thr = @store_threshold[[store.id, product.id, nil]] %>
                  <%= render "num_cell",
                        value: s_qty,
                        name: "store_products[#{store.id}][#{product.id}][qty]",
                        editable: true,
                        danger: (s_qty && s_thr && s_qty <= s_thr.to_f) %>
                  <%= render "num_cell",
                        value: s_thr,
                        name: "store_products[#{store.id}][#{product.id}][threshold]",
                        editable: true %>
                <% end %>
              </tr>

              <% variants.each do |variant| %>
                <%
                  v_stock = variant.available_stock.to_f
                  v_thr   = variant.low_stock_threshold
                %>
                <tr class="table-light" data-pse-row="<%= product.id %>">
                  <td class="ps-4 text-muted">
                    <i class="bi bi-arrow-return-right me-1"></i><%= variant.label %>
                  </td>
                  <td></td>
                  <td></td>

                  <%= render "num_cell",
                        value: v_stock,
                        name: "main_variants[#{variant.id}][stock]",
                        editable: true,
                        danger: (v_thr && v_stock <= v_thr.to_f) %>
                  <%= render "num_cell",
                        value: v_thr,
                        name: "main_variants[#{variant.id}][threshold]",
                        editable: true %>

                  <% @stores.each do |store| %>
                    <% sv_qty = @store_qty[[store.id, product.id, variant.id]] %>
                    <% sv_thr = @store_threshold[[store.id, product.id, variant.id]] %>
                    <%= render "num_cell",
                          value: sv_qty,
                          name: "store_variants[#{store.id}][#{variant.id}][qty]",
                          editable: true,
                          danger: (sv_qty && sv_thr && sv_qty.to_f <= sv_thr.to_f) %>
                    <%= render "num_cell",
                          value: sv_thr,
                          name: "store_variants[#{store.id}][#{variant.id}][threshold]",
                          editable: true %>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>

<div id="pse-overlay">
  <div class="pse-overlay-card">
    <div class="pse-pct" id="pse-pct">0%</div>
    <div class="pse-track"><div class="pse-fill" id="pse-bar"></div></div>
    <div class="pse-label" id="pse-overlay-label">Saving changes…</div>
  </div>
</div>

<script>
  (function () {
    var form      = document.getElementById('pse-form');
    var table     = document.getElementById('pse-table');
    var actions   = document.querySelector('.pse-actions');
    var cancelBtn = document.getElementById('pse-cancel-btn');
    var counter   = document.querySelector('.pse-dirty-count');
    var bulkBtn   = document.getElementById('pse-bulk-btn');
    var overlay   = document.getElementById('pse-overlay');
    var bar       = document.getElementById('pse-bar');
    var pct       = document.getElementById('pse-pct');
    var ovLabel   = document.getElementById('pse-overlay-label');
    var bulkMode  = false;

    function dirtyInputs() {
      return Array.prototype.slice.call(form.querySelectorAll('.pse-input.pse-dirty'));
    }

    function refresh() {
      var n = dirtyInputs().length;
      if (counter) counter.textContent = n;
      actions.classList.toggle('d-none', n === 0 && !bulkMode);
    }

    function startEditing(input) {
      input.classList.add('pse-editing');
      input.readOnly = false;
      input.focus();
      input.select();
    }

    function resetInput(input) {
      input.value = input.dataset.original;
      input.classList.remove('pse-editing', 'pse-dirty');
      input.readOnly = true;
    }

    // Click the pencil -> make just that one cell editable
    table.addEventListener('click', function (e) {
      var btn = e.target.closest('.pse-edit-cell');
      if (!btn) return;
      var input = btn.parentElement.querySelector('.pse-input');
      if (input) startEditing(input);
    });

    table.addEventListener('input', function (e) {
      var input = e.target;
      if (!input.classList || !input.classList.contains('pse-input')) return;
      var changed = String(input.value) !== String(input.dataset.original);
      input.classList.toggle('pse-dirty', changed);
      refresh();
    });

    // Leaving a field that wasn't changed puts it back to read-only
    // (skipped in bulk mode, where every cell stays open)
    table.addEventListener('focusout', function (e) {
      if (bulkMode) return;
      var input = e.target;
      if (!input.classList || !input.classList.contains('pse-input')) return;
      if (String(input.value) === String(input.dataset.original)) resetInput(input);
    });

    function setBulkMode(on) {
      bulkMode = on;
      form.querySelectorAll('.pse-input').forEach(function (input) {
        if (on) {
          input.readOnly = false;
          input.classList.add('pse-editing');
        } else if (String(input.value) === String(input.dataset.original)) {
          resetInput(input);
        }
      });
      bulkBtn.classList.toggle('btn-primary', !on);
      bulkBtn.classList.toggle('btn-warning', on);
      bulkBtn.innerHTML = on
        ? '<i class="bi bi-x-lg me-1"></i>Exit Bulk Edit'
        : '<i class="bi bi-pencil-square me-1"></i>Bulk Edit';
      refresh();
    }

    if (bulkBtn) {
      bulkBtn.addEventListener('click', function () { setBulkMode(!bulkMode); });
    }

    if (cancelBtn) {
      cancelBtn.addEventListener('click', function () {
        form.querySelectorAll('.pse-input').forEach(resetInput);
        if (bulkMode) setBulkMode(false);
        refresh();
      });
    }

    // ---- submit: only post the cells that actually changed -----------------
    // The table has thousands of inputs (every product x store x stock/threshold).
    // Posting all of them blows past Rack's parameter limit -> the whole request
    // is rejected and nothing saves. Disabling the untouched inputs keeps the
    // payload to just the edits, which is also what makes the save fast.
    function startProgress(count) {
      overlay.classList.add('pse-show');
      ovLabel.textContent = 'Saving ' + count + (count === 1 ? ' change…' : ' changes…');
      // The save now batches its writes, so time is roughly flat regardless of
      // how many cells changed — a small per-change nudge just keeps the bar moving.
      var estMs = 800 + count * 25;
      var start = Date.now();
      var timer = setInterval(function () {
        var t = (Date.now() - start) / estMs;
        var p = t < 1 ? (1 - Math.pow(1 - t, 3)) * 90 : Math.min(98, 90 + (t - 1) * 5);
        bar.style.width = p.toFixed(1) + '%';
        pct.textContent = Math.round(p) + '%';
      }, 60);
      window.addEventListener('pagehide', function () {
        clearInterval(timer);
        bar.style.width = '100%';
        pct.textContent = '100%';
      });
    }

    form.addEventListener('submit', function (e) {
      var dirty = dirtyInputs();
      if (dirty.length === 0) {
        e.preventDefault();
        alert('No changes to save — edit a cell first.');
        return;
      }
      form.querySelectorAll('.pse-input').forEach(function (input) {
        if (!input.classList.contains('pse-dirty')) input.disabled = true;
      });
      startProgress(dirty.length);
    });

    // ---- product search (Select2) -----------------------------------------
    // Filters the table down to one product's rows (parent + variants). Clearing
    // the box, or "Show all", brings every row back.
    (function () {
      if (typeof window.jQuery === 'undefined' || !jQuery.fn.select2) return;
      var $search = jQuery('#pse-search');
      var allRows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-pse-row]'));

      function showAll() {
        allRows.forEach(function (tr) { tr.hidden = false; });
      }

      function filterTo(pid) {
        if (!pid) { showAll(); return; }
        var first = null;
        allRows.forEach(function (tr) {
          var match = tr.getAttribute('data-pse-row') === String(pid);
          tr.hidden = !match;
          if (match && !first) first = tr;
        });
        if (first) first.scrollIntoView({ block: 'center' });
      }

      $search.select2({
        theme: 'bootstrap-5',
        width: '100%',
        allowClear: true,
        placeholder: $search.data('placeholder')
      });
      $search.on('change', function () { filterTo($search.val()); });

      var clearBtn = document.getElementById('pse-search-clear');
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          $search.val('').trigger('change');
        });
      }
    })();

    // Restore a usable page if the browser navigates back to it from bfcache.
    window.addEventListener('pageshow', function () {
      overlay.classList.remove('pse-show');
      bar.style.width = '0';
      pct.textContent = '0%';
      form.querySelectorAll('.pse-input').forEach(function (input) { input.disabled = false; });
    });
  })();
</script>
