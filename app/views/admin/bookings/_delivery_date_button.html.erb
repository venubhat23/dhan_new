<%# Shows a booking's delivery date (+ optional time); clicking opens the modal in _delivery_date_modal. %>
<% delivery_date = booking.expected_delivery_date %>
<%# Pass show_time: false to show only the date (the modal still gets the saved time). %>
<% delivery_time_label = delivery_date && local_assigns.fetch(:show_time, true) && booking.expected_delivery_time_label %>
<button type="button"
        class="btn btn-sm text-nowrap <%= delivery_date ? 'btn-outline-primary' : 'btn-outline-secondary' %>"
        title="<%= delivery_date ? 'Change delivery date' : 'Set delivery date' %>"
        data-url="<%= update_delivery_date_admin_booking_path(booking) %>"
        data-booking-number="<%= booking.booking_number %>"
        data-delivery-date="<%= delivery_date&.iso8601 %>"
        data-delivery-time="<%= booking.expected_delivery_time if delivery_date %>"
        onclick="openDeliveryDateModal(this)">
  <i class="bi bi-calendar-event me-1"></i><%= delivery_date ? delivery_date.strftime('%d %b %Y') : 'Set Date & Time' %>
  <% if delivery_time_label %>
    <span class="ms-1"><i class="bi bi-clock me-1"></i><%= delivery_time_label %></span>
  <% end %>
</button>
