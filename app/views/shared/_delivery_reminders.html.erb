<%#
  Scheduled-delivery reminder pop-up for admins (rendered from the admin
  layout). Polls admin/bookings#due_deliveries every 2 minutes and pops up:
    * a booking whose delivery TIME is within the next 30 minutes (or up to
      60 minutes overdue) — once per booking + time slot;
    * once a day, the list of today's scheduled deliveries.
  "Seen" markers live in localStorage so reloading/navigating doesn't re-pop.
%>
<div class="modal fade" id="deliveryReminderModal" tabindex="-1" aria-labelledby="deliveryReminderTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header bg-warning-subtle">
        <h5 class="modal-title" id="deliveryReminderTitle"><i class="bi bi-alarm me-2"></i>Scheduled Deliveries</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div id="deliveryReminderDue"></div>
        <div id="deliveryReminderToday"></div>
      </div>
      <div class="modal-footer">
        <a href="<%= admin_bookings_path %>" class="btn btn-outline-primary btn-sm me-auto">All Bookings</a>
        <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    if (window.__deliveryReminderBound) return;
    window.__deliveryReminderBound = true;

    var URL_ = '<%= due_deliveries_admin_bookings_path(format: :json) %>';
    var POLL_MS = 2 * 60 * 1000;

    function store(key, val) {
      try { if (val === undefined) return localStorage.getItem(key); localStorage.setItem(key, val); } catch (e) { return null; }
    }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function whenText(b) {
      if (b.minutes_until == null) return '';
      if (b.minutes_until > 0) return 'in ' + b.minutes_until + ' min';
      if (b.minutes_until === 0) return 'now';
      return Math.abs(b.minutes_until) + ' min overdue';
    }
    function row(b, highlight) {
      return '<a href="' + esc(b.url) + '" class="list-group-item list-group-item-action' + (highlight ? ' list-group-item-warning' : '') + '">' +
        '<div class="d-flex justify-content-between align-items-start gap-2">' +
          '<div><div class="fw-semibold">#' + esc(b.booking_number) + ' · ' + esc(b.customer_name || '—') + '</div>' +
          '<div class="small text-muted">' + esc(b.customer_phone || '') + (b.address ? ' · ' + esc(b.address) : '') + '</div></div>' +
          '<div class="text-end text-nowrap">' +
            '<div class="fw-semibold"><i class="bi bi-clock me-1"></i>' + esc(b.time_label || 'Any time') + '</div>' +
            (highlight ? '<div class="small text-danger fw-semibold">' + esc(whenText(b)) + '</div>' : '<div class="small text-muted">' + esc(b.status) + '</div>') +
          '</div>' +
        '</div></a>';
    }

    function check() {
      if (!document.getElementById('deliveryReminderModal')) return;
      fetch(URL_, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.bookings) return;
          var due = data.bookings.filter(function (b) {
            return b.due && !store('dlvReminder:' + b.id + ':' + data.date + ':' + b.time);
          });
          var dailyKey = 'dlvReminderDaily:' + data.date;
          var showDaily = data.bookings.length > 0 && !store(dailyKey);
          if (!due.length && !showDaily) return;

          var modalEl = document.getElementById('deliveryReminderModal');
          if (modalEl.classList.contains('show')) return; // already open

          document.getElementById('deliveryReminderDue').innerHTML = due.length
            ? '<div class="px-3 pt-3 pb-1 small fw-bold text-danger text-uppercase"><i class="bi bi-exclamation-circle me-1"></i>Due now</div>' +
              '<div class="list-group list-group-flush">' + due.map(function (b) { return row(b, true); }).join('') + '</div>'
            : '';
          var rest = showDaily ? data.bookings.filter(function (b) { return due.indexOf(b) === -1; }) : [];
          document.getElementById('deliveryReminderToday').innerHTML = rest.length
            ? '<div class="px-3 pt-3 pb-1 small fw-bold text-muted text-uppercase"><i class="bi bi-calendar-event me-1"></i>Today\'s scheduled deliveries (' + data.bookings.length + ')</div>' +
              '<div class="list-group list-group-flush">' + rest.map(function (b) { return row(b, false); }).join('') + '</div>'
            : '';

          due.forEach(function (b) { store('dlvReminder:' + b.id + ':' + data.date + ':' + b.time, '1'); });
          if (showDaily) store(dailyKey, '1');

          if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        })
        .catch(function () {});
    }

    function start() { setTimeout(check, 1500); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
    setInterval(check, POLL_MS);
  })();
</script>
