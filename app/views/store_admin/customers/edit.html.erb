<% content_for :page_title, "Edit Customer" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Edit Customer</h4>
    <small class="text-muted"><%= @customer.full_name %></small>
  </div>
  <%= link_to store_admin_customer_path(@customer), class: "btn btn-outline-secondary" do %>
    <i class="bi bi-arrow-left me-2"></i>Back to Customer
  <% end %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <%= render "form" %>
  </div>
</div>
