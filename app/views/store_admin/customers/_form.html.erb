<%= form_with model: [:store_admin, @customer], local: true do |f| %>
  <% if @customer.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Full Name <span class="text-danger">*</span></label>
      <%= f.text_field :full_name, class: "form-control", required: true %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Mobile <span class="text-danger">*</span></label>
      <%= f.telephone_field :mobile, class: "form-control", required: true %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Email</label>
      <%= f.email_field :email, class: "form-control" %>
    </div>
    <div class="col-md-6">
      <label class="form-label">WhatsApp Number</label>
      <%= f.telephone_field :whatsapp_number, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <label class="form-label">Gender</label>
      <%= f.select :gender, options_for_select([['Male', 'Male'], ['Female', 'Female'], ['Other', 'Other']], @customer.gender), { include_blank: true }, class: "form-select" %>
    </div>
    <div class="col-md-4">
      <label class="form-label">Birth Date</label>
      <%= f.date_field :birth_date, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <label class="form-label">Status</label>
      <%= f.select :status, options_for_select([['Active', true], ['Inactive', false]], @customer.status), {}, class: "form-select" %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Company Name</label>
      <%= f.text_field :company_name, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <label class="form-label">GST No.</label>
      <%= f.text_field :gst_no, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <label class="form-label">Occupation</label>
      <%= f.text_field :occupation, class: "form-control" %>
    </div>
    <div class="col-12">
      <label class="form-label">Address</label>
      <%= f.text_area :address, class: "form-control", rows: 2 %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Landmark</label>
      <%= f.text_field :landmark, class: "form-control" %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Location Link</label>
      <%= f.text_field :location_link, class: "form-control" %>
    </div>
    <div class="col-12">
      <label class="form-label">Shipping Address</label>
      <%= f.text_area :shipping_address, class: "form-control", rows: 2 %>
    </div>
    <div class="col-12">
      <label class="form-label">Notes</label>
      <%= f.text_area :notes, class: "form-control", rows: 2 %>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", store_admin_customers_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
