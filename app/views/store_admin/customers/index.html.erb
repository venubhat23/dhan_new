<% content_for :page_title, "Customers" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="mb-1">Store Customers</h4>
    <small class="text-muted">Customers who have booked at <%= @current_store.name %></small>
  </div>
  <%= link_to new_store_admin_customer_path, class: "btn btn-primary" do %>
    <i class="bi bi-person-plus me-2"></i>Add Customer
  <% end %>
</div>

<div class="row mb-4">
  <div class="col-md-4 mb-3">
    <div class="card shadow-sm border-0" style="border-left: 4px solid #10b981 !important;">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h6 class="card-title mb-2" style="color: #2d3748; font-weight: 600;">Total Customers</h6>
          <div style="color: #1a202c; font-weight: 800; font-size: 1.8rem;"><%= number_with_delimiter(@total_customers) %></div>
          <small class="text-muted">with bookings at this store</small>
        </div>
        <i class="bi bi-people" style="color: rgba(45,55,72,0.2); font-size: 3rem;"></i>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <%= form_tag store_admin_customers_path, method: :get, local: true, class: "row g-3 align-items-end" do %>
      <div class="col-md-5">
        <label class="form-label small">Search</label>
        <%= text_field_tag :search, params[:search], class: "form-control form-control-sm", placeholder: "Name, mobile or email" %>
      </div>
      <div class="col-md-3">
        <%= submit_tag "Filter", class: "btn btn-primary btn-sm" %>
        <%= link_to "Clear", store_admin_customers_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-0">
    <h6 class="mb-0"><i class="bi bi-list me-2"></i>Customer List</h6>
  </div>
  <div class="card-body p-0">
    <% if @customers.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Mobile</th>
              <th>Email</th>
              <th>Since</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @customers.each do |customer| %>
              <tr>
                <td><strong><%= customer.full_name %></strong></td>
                <td><%= customer.mobile %></td>
                <td><%= customer.placeholder_email? ? content_tag(:span, "—", class: "text-muted") : customer.email %></td>
                <td><small class="text-muted"><%= customer.created_at.strftime('%d %b %Y') %></small></td>
                <td>
                  <div class="btn-group" role="group">
                    <%= link_to store_admin_customer_path(customer), class: "btn btn-sm btn-outline-primary" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_store_admin_customer_path(customer), class: "btn btn-sm btn-outline-secondary" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="p-3">
        <%= paginate @customers if @customers.respond_to?(:current_page) %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-people fs-1 text-muted mb-3"></i>
        <h5 class="text-muted">No Customers Found</h5>
        <%= link_to "Add Customer", new_store_admin_customer_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
